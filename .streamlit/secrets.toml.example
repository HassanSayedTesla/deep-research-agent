# Local Streamlit secrets template. Do not put real keys in this file.
#
# For local development:
#   1. Copy this file to `.streamlit/secrets.toml` (that filename is ignored by git).
#   2. Replace the placeholder values below.
#   3. Run `streamlit run streamlit_app.py` from the repository root.
#
# For Streamlit Community Cloud, paste the same TOML keys into the app's
# Secrets settings instead of committing a secrets file.

GROQ_API_KEY = "gsk_replace_me"

# Only the key for the selected SEARCH_PROVIDER is required.
TAVILY_API_KEY = "tvly_replace_me"
# SERPER_API_KEY = "replace_me"
