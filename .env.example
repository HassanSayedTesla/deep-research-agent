# --- Required -------------------------------------------------------------
# Groq powers the LLM (replaces OpenAI from the course notebooks).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Web search -----------------------------------------------------------
# Two providers are supported. Set SEARCH_PROVIDER to pick one; only that
# provider's key is required. Leave both blank and set SEARCH_PROVIDER=none to
# run without any network search (the researcher then reasons from its own
# knowledge).
#
# Tavily is the search backend the course uses. Built for agents, returns a
# synthesised `answer` alongside the sources. Free tier is enough.
# https://app.tavily.com/home
TAVILY_API_KEY=tvly_...
# Google Serper is a thin front end over Google Search: cheaper per query, no
# synthesised answer, and results carry a publication date.
# https://serper.dev
SERPER_API_KEY=
# Override only for a proxy or a self-hosted Serper instance.
SERPER_BASE_URL=https://google.serper.dev

SEARCH_PROVIDER=tavily

# --- Model ----------------------------------------------------------------
MODEL=qwen/qwen3.8-27b
TEMPERATURE=0.2
# Ceiling on tokens generated per call. This must stay under your provider's
# per-minute OUTPUT budget, because a single request asking for more is refused
# outright. Groq's free tier allows 1000 output tokens/minute, and without this
# cap every call fails with:
#   429 Request too large ... OTPM: Limit 1000, Requested 1108
# Waiting does not help, because the next request asks for the same amount.
# Raise it on a paid tier, lower it if the writer's report gets cut short.
MAX_OUTPUT_TOKENS=512

# --- Web search tuning ----------------------------------------------------
# Results requested per search query.
SEARCH_MAX_RESULTS=4

# --- Orchestration knobs --------------------------------------------------
# How many questions the planner may generate per round.
MAX_QUESTIONS=5
# How many times the critic can send the draft back for revision.
MAX_REVIEW_CYCLES=2
# How many research workers may run at the same time.
# Read once at import (num_workers is fixed when the step is declared),
# so change it before starting the process.
CONCURRENCY=4

# How many LLM turns may be in flight at once, counted across all researchers.
# Separate from CONCURRENCY on purpose: each researcher's turn re-sends the
# system prompt, tool schema and its own notes, so several at once can exceed a
# per-minute INPUT budget even when requests themselves are fine. Groq's free
# tier allows 7000 input tokens/minute, which fits about two researchers.
LLM_CONCURRENCY=2

# --- Storage --------------------------------------------------------------
RUNS_DIR=runs
CACHE_FILE=.cache/search.json
CACHE_TTL_HOURS=24
