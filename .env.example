# --- Required -------------------------------------------------------------
# Groq powers the LLM (replaces OpenAI from the course notebooks).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Web search -----------------------------------------------------------
# Two providers are supported. Set SEARCH_PROVIDER to pick one; only that
# provider's key is required. Leave both blank and set SEARCH_PROVIDER=none to
# run without any network search (the researcher then reasons from its own
# knowledge).
#
# Tavily is the search backend the course uses. Built for agents, returns a
# synthesised `answer` alongside the sources. Free tier is enough.
# https://app.tavily.com/home
TAVILY_API_KEY=tvly_...
# Google Serper is a thin front end over Google Search: cheaper per query, no
# synthesised answer, and results carry a publication date.
# https://serper.dev
SERPER_API_KEY=
# Override only for a proxy or a self-hosted Serper instance.
SERPER_BASE_URL=https://google.serper.dev

SEARCH_PROVIDER=tavily

# --- Model ----------------------------------------------------------------
MODEL=qwen/qwen3.8-27b
TEMPERATURE=0.2
# Ceiling on tokens generated per call. This must stay under your provider's
# per-minute OUTPUT budget, because a single request asking for more is refused
# outright. Groq's free tier allows 1000 output tokens/minute, and without this
# cap every call fails with:
#   429 Request too large ... OTPM: Limit 1000, Requested 1108
# Waiting does not help, because the next request asks for the same amount.
# Raise it on a paid tier, lower it if the writer's report gets cut short.
MAX_OUTPUT_TOKENS=512
# The largest single response the provider will grant. The writer retries a
# truncated draft asking for more room, and a request for more than a minute's
# whole output budget is refused outright ("429 Request too large"), which no
# amount of waiting can fix. Groq's free tier allows 1000 per minute; raise this
# on a paid tier.
MAX_OUTPUT_CEILING=1000

# --- Web search tuning ----------------------------------------------------
# Results requested per search query.
SEARCH_MAX_RESULTS=4

# --- Orchestration knobs --------------------------------------------------
# How many questions the planner may generate per round. Each one is a
# concurrent researcher with its own context, so this multiplies the per-minute
# provider cost. Five is for a paid tier; the free tier can afford two.
MAX_QUESTIONS=2
# How many times the critic can send the draft back for revision.
MAX_REVIEW_CYCLES=2
# Tool-calling turns one researcher may take. Each turn re-sends the system
# prompt, the tool schema and every result gathered so far, so this is the
# main brake on the provider's per-minute input budget. On reaching it the
# researcher writes up what it has instead of failing the run.
RESEARCHER_MAX_ITERATIONS=6
# How many research workers may run at the same time.
# Read once at import (num_workers is fixed when the step is declared),
# so change it before starting the process.
CONCURRENCY=4

# How many LLM turns may be in flight at once, counted across all researchers.
# Separate from CONCURRENCY on purpose: each researcher's turn re-sends the
# Each researcher re-sends its system prompt, the tool schema and every result
# gathered so far, so concurrency is a statement about the provider's per-minute
# INPUT budget. Groq's free tier allows 7000 input tokens/minute and a research
# turn costs ~1400, so two at once fits only just and bursts over: a live run
# measured `ITPM: Limit 7000, Used 6669, Requested 1399` and lost a whole
# researcher to it. One at a time stays inside the budget; raise this to 2 or
# more on a paid tier, where the ceiling is far higher.
LLM_CONCURRENCY=1

# --- Storage --------------------------------------------------------------
RUNS_DIR=runs
CACHE_FILE=.cache/search.json
CACHE_TTL_HOURS=24
