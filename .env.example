# --- Required -------------------------------------------------------------
# Groq powers the LLM (replaces OpenAI from the course notebooks).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Web search -----------------------------------------------------------
# Tavily is the search backend the course uses. Free tier is enough.
# https://app.tavily.com/home
TAVILY_API_KEY=tvly_...

# Set to "none" to run the workflow without any network search
# (the researcher agent will then only reason from its own knowledge).
SEARCH_PROVIDER=tavily

# --- Model ----------------------------------------------------------------
MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# --- Orchestration knobs --------------------------------------------------
# How many questions the planner may generate per round.
MAX_QUESTIONS=5
# How many times the critic can send the draft back for revision.
MAX_REVIEW_CYCLES=2
# How many research workers may run at the same time.
# Read once at import (num_workers is fixed when the step is declared),
# so change it before starting the process.
CONCURRENCY=4

# --- Storage --------------------------------------------------------------
RUNS_DIR=runs
CACHE_FILE=.cache/search.json
CACHE_TTL_HOURS=24
