# --- Required -------------------------------------------------------------
# Groq powers the LLM (replaces OpenAI from the course notebooks).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Web search -----------------------------------------------------------
# Two providers are supported. Set SEARCH_PROVIDER to pick one; only that
# provider's key is required. Leave both blank and set SEARCH_PROVIDER=none to
# run without any network search (the researcher then reasons from its own
# knowledge).
#
# Tavily is the search backend the course uses. Built for agents, returns a
# synthesised `answer` alongside the sources. Free tier is enough.
# https://app.tavily.com/home
TAVILY_API_KEY=tvly_...
# Google Serper is a thin front end over Google Search: cheaper per query, no
# synthesised answer, and results carry a publication date.
# https://serper.dev
SERPER_API_KEY=
# Override only for a proxy or a self-hosted Serper instance.
SERPER_BASE_URL=https://google.serper.dev

SEARCH_PROVIDER=tavily

# --- Model ----------------------------------------------------------------
MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# --- Web search tuning ----------------------------------------------------
# Results requested per search query.
SEARCH_MAX_RESULTS=4

# --- Orchestration knobs --------------------------------------------------
# How many questions the planner may generate per round.
MAX_QUESTIONS=5
# How many times the critic can send the draft back for revision.
MAX_REVIEW_CYCLES=2
# How many research workers may run at the same time.
# Read once at import (num_workers is fixed when the step is declared),
# so change it before starting the process.
CONCURRENCY=4

# --- Storage --------------------------------------------------------------
RUNS_DIR=runs
CACHE_FILE=.cache/search.json
CACHE_TTL_HOURS=24
