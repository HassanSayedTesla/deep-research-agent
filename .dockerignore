# Keep the build context small and secrets out of the image.
.git
.gitignore
.github
.venv
venv
env
.env
.env.*
!.env.example

__pycache__
*.py[cod]
*.egg-info
build
dist

# Not needed at runtime: the image runs the installed package.
tests
docs
lib
scripts
README.md.bak

# Runtime output
runs
.cache
